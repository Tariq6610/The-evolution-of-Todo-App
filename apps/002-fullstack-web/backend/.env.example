# Backend Environment Variables
# For Neon DB, use the connection string from your Neon dashboard:
# Format: postgresql://username:password@ep-xxxxxx.region.provider.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://username:password@ep-xxxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
SECRET_KEY=your-secret-key-for-jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
